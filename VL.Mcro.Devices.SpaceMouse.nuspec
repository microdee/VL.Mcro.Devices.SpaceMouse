    <metadata>
        <id>VL.Mcro.Devices.SpaceMouse</id>
        <version>1.0.0-pre1</version>
        <description>A native implementation for reading 3DConnexion Space Mice from HID directly</description>
        <authors>David Morasz</authors>
        <icon>icon\SpaceNav-Src_256.png</icon>
        <readme>README.md</readme>
