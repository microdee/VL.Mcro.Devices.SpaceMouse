        <tags>VL vvvv devices spacemouse 3dconnexion</tags>
        <dependencies>
            <group targetFramework="net8.0">
                <dependency id="VL.Core" version="2025.7.4" />
                <dependency id="Stride.Core.Mathematics" version="4.3.0.2507" />
            </group>
        </dependencies>
    </metadata>
    <files>
        <file
            src="**"
            target="\"
            exclude=".git\**\*;.vscode\**\*;cpp\**\*"
            include="help\**;icon\**;lib\**;LICENSE;README.md"
        />
    </files>
